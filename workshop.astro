<script is:inline>
(function(){
  var btn=document.getElementById('copy-btn'),toast=document.getElementById('toast');
  if(!btn||!toast)return;
  var msg='AI全貌';
  function done(t){toast.textContent=t;clearTimeout(done._t);done._t=setTimeout(function(){toast.textContent=''},3200)}
  function fallback(){
    var kw=document.querySelector('.w-finale .w-keyword');
    try{var r=document.createRange();r.selectNodeContents(kw);var s=getSelection();s.removeAllRanges();s.addRange(r)}catch(e){}
    done('已選取「AI全貌」，請長按或按 Ctrl+C 複製');
  }
  btn.addEventListener('click',function(){
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(msg).then(function(){done('已複製「AI全貌」，貼到留言或私訊就可以了')},fallback);
    }else fallback();
  });
})();
</script>

<script is:inline>
/* 工作坊 HERO 主視覺輪播 */
(function(){
  var car = document.querySelector('.w-hero2-media.wh-car');
  if (!car) return;
  var slides = [].slice.call(car.querySelectorAll('.wh-track .w-shot'));
  var dots   = [].slice.call(car.querySelectorAll('.wh-dots button'));
  if (slides.length < 2) return;
  var i = 0, timer = null;
  var reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s,k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d,k){
      d.classList.toggle('is-on', k === i);
      d.setAttribute('aria-selected', k === i ? 'true' : 'false');
    });
  }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  function play(){ stop(); if (!reduce) timer = setInterval(function(){ go(i+1); }, 5500); }

  dots.forEach(function(d,k){ d.addEventListener('click', function(){ go(k); play(); }); });
  /* 只有滑到點點或鍵盤聚焦才暫停，整張主視覺不暫停 */
  var box = car.querySelector('.wh-dots');
  if (box){ box.addEventListener('mouseenter', stop); box.addEventListener('mouseleave', play); }
  car.addEventListener('focusin', stop);
  car.addEventListener('focusout', play);

  /* 手機滑動切換 */
  var x0 = null;
  car.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; stop(); }, {passive:true});
  car.addEventListener('touchend', function(e){
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 45) go(dx < 0 ? i+1 : i-1);
    x0 = null; play();
  }, {passive:true});

  /* 分頁切走時停掉，省電也避免回來時連跳好幾張 */
  document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : play(); });

  go(0); play();
})();
</script>
