<!-- ============ AI 商業觀察 ============ -->

<script is:inline>
/* 案例卡 → 作品彈窗 */
(function(){
  var openers = document.querySelectorAll('[data-open]');
  if (!openers.length) return;

  function bind(dlg){
    var vid = dlg.querySelector('video');
    function shut(){ if (dlg.open) dlg.close(); }
    dlg.addEventListener('close', function(){
      if (vid) { vid.pause(); }
      document.documentElement.style.overflow = '';
    });
    /* 點彈窗外圍的暗底關閉；點內容不關 */
    dlg.addEventListener('click', function(e){ if (e.target === dlg) shut(); });
    dlg.querySelectorAll('[data-close]').forEach(function(b){ b.addEventListener('click', shut); });
  }

  openers.forEach(function(btn){
    var dlg = document.getElementById(btn.getAttribute('data-open'));
    if (!dlg) return;
    if (!dlg.dataset.bound) { bind(dlg); dlg.dataset.bound = '1'; }
    btn.addEventListener('click', function(){
      document.documentElement.style.overflow = 'hidden';
      if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open','');
      var c = dlg.querySelector('.wm-close'); if (c) c.focus();
    });
  });
})();
</script>
