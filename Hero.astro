<header class="hero">
  <span class="hero-orb a"></span>
  <span class="hero-orb b"></span>

  <div class="wrap hero-grid">
    <div>
      <div class="hero-meta-top reveal">
        <span class="label">Established · Taipei · 2026</span>
        <span class="label label-soft">Issue Nº 01</span>
      </div>

      <div class="eyebrow reveal" style="margin-bottom:32px">AI ／ Brand ／ Human</div>

      <h1 class="reveal d1">
        <span class="br">你<em>很專業</em>。</span>
        <span class="br">但市場，</span>
        <span class="br">還沒真正<em>看見你</em>。</span>
      </h1>

      <p class="hero-sub reveal d2">
        你不是不夠專業。<br>
        只是市場，還沒真正理解你的價值。<br><br>
        我們用 AI、品牌策略與視覺導演，
        把你的專業，
        <strong>翻譯成市場願意相信的語言</strong>。
      </p>

      <div class="cta-row reveal d3">
        <a href="https://ai-persona-scan.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          開始你的 AI 定位探索
          <span class="arrow">→</span>
        </a>
        <a href="/#services" class="btn btn-ghost">看看我們怎麼幫你</a>
      </div>

      <p class="hero-fit reveal d3">
        <span class="hero-fit-lbl">適合</span>
        顧問　·　講師　·　健康產業　·　創業者　·　專業工作者
      </p>

      <div class="hero-trust reveal d4">
        <div class="trust-item"><span class="num">03</span><span class="lbl">核心服務體系</span></div>
        <div class="trust-item"><span class="num">120<em style="font-family:'Cormorant Garamond';font-style:italic;font-size:.7em;color:var(--gold)">+</em></span><span class="lbl">合作品牌與個人</span></div>
        <div class="trust-item"><span class="num">2.4<em style="font-family:'Cormorant Garamond';font-style:italic;font-size:.7em;color:var(--gold)">×</em></span><span class="lbl">客戶平均成交提升</span></div>
        <div class="trust-item"><span class="num">∞</span><span class="lbl">每一個人的可能性</span></div>
      </div>
    </div>

    <aside class="hero-aside reveal d3">
      <div class="ai-scope">
        <div class="ai-grid"></div>
        <div class="ai-orb-soft"></div>

        <div class="ai-status">
          <span class="ai-dot"></span>
          <span>AI 正在閱讀你的品牌訊號</span>
        </div>

        <!-- Card 1 · AI Persona -->
        <article class="hv-card hv-persona">
          <div class="hv-head">
            <span class="hv-tag"><span class="hv-tag-dot"></span>AI Persona</span>
            <span class="hv-meta">analysis 03</span>
          </div>
          <div class="hv-section-label">你的品牌核心</div>
          <h4 class="hv-name">「<em>光的編譯者</em>」</h4>
          <p class="hv-body">把抽象的價值，<br>翻譯成市場願意相信的語言。</p>
          <div class="hv-bar">
            <div class="hv-bar-track"><span class="hv-bar-fill"></span></div>
            <span class="hv-bar-num">97<span class="hv-pct">%</span></span>
          </div>
          <div class="hv-corner-glyph"></div>
        </article>

        <!-- Card 2 · Sales Flow（垂直旅程，更顯儀式感） -->
        <article class="hv-card hv-flow">
          <div class="hv-head">
            <span class="hv-tag"><span class="hv-tag-dot"></span>Sales Flow</span>
            <span class="hv-meta">04 stages</span>
          </div>
          <div class="hv-section-label">客戶旅程</div>
          <div class="hv-journey-v">
            <div class="jrow"><span class="jstep">共鳴</span><span class="jline"></span></div>
            <div class="jrow"><span class="jstep">理解</span><span class="jline"></span></div>
            <div class="jrow"><span class="jstep">信任</span><span class="jline"></span></div>
            <div class="jrow"><span class="jstep active">行動</span><span class="jdot"></span></div>
          </div>
        </article>

        <!-- Card 3 · Brand Voice（三條 AI 量表，取代橫排 pill） -->
        <article class="hv-card hv-voice">
          <div class="hv-head">
            <span class="hv-tag"><span class="hv-tag-dot"></span>Brand Voice</span>
          </div>
          <div class="hv-section-label">你的品牌感受</div>
          <div class="hv-meters">
            <div class="meter">
              <span class="meter-lbl">溫度感</span>
              <span class="meter-track"><span class="meter-fill" style="--w:88%"></span></span>
              <span class="meter-num">88</span>
            </div>
            <div class="meter">
              <span class="meter-lbl">專業感</span>
              <span class="meter-track"><span class="meter-fill" style="--w:94%"></span></span>
              <span class="meter-num">94</span>
            </div>
            <div class="meter">
              <span class="meter-lbl">未來感</span>
              <span class="meter-track"><span class="meter-fill" style="--w:81%"></span></span>
              <span class="meter-num">81</span>
            </div>
          </div>
        </article>
      </div>
    </aside>
  </div>
</header>

